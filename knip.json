{
  "ignoreDependencies": [
    "pino-pretty",
    "@babel/core",
    "ts-node",
    "@prisma/client",
    "lefthook",
    "@commitlint/cli"
  ],
  "workspaces": {
    "apps/api": {
      "ignore": ["src/infrastructure/auth/jwtMiddleware.ts", "integration/testAuth.ts"]
    },
    "apps/web": {
      "entry": ["webpack.dependency-cruiser.cjs"],
      "ignoreDependencies": ["@tanstack/react-table"]
    },
    "apps/mobile": {
      "metro": false,
      "entry": ["metro.config.js", "postcss.config.js", "webpack.dependency-cruiser.cjs"],
      "ignoreDependencies": ["react-native-css-interop"]
    },
    "infra": {
      "entry": ["bin/infra.ts"]
    }
  }
}
