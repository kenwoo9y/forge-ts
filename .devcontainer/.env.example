# Copy this file to `.devcontainer/.env` and customize as needed.

# PostgreSQL credentials for the local dev container — choose any values you like.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# AWS SSO settings — obtained from your AWS SSO portal / admin.
# SSO_SESSION: any name you like (e.g. my-company, project-name)
SSO_SESSION=
SSO_START_URL=
SSO_REGION=
SSO_ACCOUNT_ID=
SSO_ROLE_NAME=
