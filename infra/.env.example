# AWS Account ID — optional, external. Set only if you're adding a separate
# pipeline/STG/PROD AWS account (see docs/deploy.md).
# PIPELINE_ACCOUNT_ID=
# STG_ACCOUNT_ID=
# PROD_ACCOUNT_ID=

# The values below are the CDK's built-in defaults for the DEV environment,
# shown here for reference — uncomment and change only the ones you want to
# override. Each is prefixed per environment (DEV_ / STG_ / PROD_); only the
# DEV_ ones are shown here since DEV is always deployed.

# VPC
# DEV_MAX_AZS=2

# RDS
# DEV_DB_INSTANCE_TYPE=t3.micro
# DEV_DB_ALLOCATED_STORAGE=20
# DEV_DB_MAX_ALLOCATED_STORAGE=100

# API (ECS Fargate)
# DEV_API_CPU=256
# DEV_API_MEMORY_MIB=512
# DEV_API_DESIRED_COUNT=1

# Web (ECS Fargate)
# DEV_WEB_CPU=256
# DEV_WEB_MEMORY_MIB=512
# DEV_WEB_DESIRED_COUNT=1
