{
  "name": "api",
  "type": "module",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@prisma/adapter-pg": "^7.10.0",
    "db": "workspace:*",
    "error": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.1",
    "jose": "^6.2.10",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "schema": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "dependenciesMeta": {
    "db": {
      "injected": true
    },
    "error": {
      "injected": true
    },
    "schema": {
      "injected": true
    }
  }
}
