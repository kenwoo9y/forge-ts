# Use a dedicated test database, separate from your dev database (POSTGRES_DB in .devcontainer/.env).
# (Integration tests TRUNCATE the target tables, so pointing this at the dev database would wipe your dev data.)
DB_HOST=postgres
DB_PORT=5432
# DB_NAME: the test database name you created.
# DB_USERNAME/DB_PASSWORD: same values as POSTGRES_USER/POSTGRES_PASSWORD in .devcontainer/.env
DB_NAME=<POSTGRES_TEST_DB>
DB_USERNAME=<POSTGRES_USER>
DB_PASSWORD=<POSTGRES_PASSWORD>
# Any random string you choose — used to sign JWTs
JWT_SECRET="your-secret-key"
LOG_LEVEL=silent
